# syntax=docker/dockerfile:1.4
# 使用BuildKit语法进行多阶段构建优化

# 基础镜像阶段
FROM --platform=linux/amd64 node:20-alpine AS base
WORKDIR /app
ENV NODE_OPTIONS=--openssl-legacy-provider
ENV NODE_ENV=production

# 安装系统依赖
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/*

# 依赖安装阶段
FROM base AS deps
COPY package*.json ./
RUN npm ci --registry=https://registry.npmmirror.com --frozen-lockfile && \
    npm cache clean --force

# 构建阶段
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# 构建应用
RUN npm run build

# 生产阶段
FROM --platform=linux/amd64 nginx:alpine AS production

# 添加非root用户
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# 复制构建产物
COPY --from=builder --chown=nextjs:nodejs /app/dist /usr/share/nginx/html

# 复制nginx配置
COPY ./nginx.conf /etc/nginx/conf.d/default.conf

# 优化nginx配置
RUN echo 'worker_processes auto;' > /etc/nginx/nginx.conf && \
    echo 'events { worker_connections 1024; }' >> /etc/nginx/nginx.conf && \
    echo 'http { include /etc/nginx/mime.types; default_type application/octet-stream;' >> /etc/nginx/nginx.conf && \
    echo 'sendfile on; tcp_nopush on; tcp_nodelay on; keepalive_timeout 65;' >> /etc/nginx/nginx.conf && \
    echo 'gzip on; gzip_vary on; gzip_min_length 1024; gzip_types text/plain text/css application/json application/javascript text/xml application/xml;' >> /etc/nginx/nginx.conf && \
    echo 'include /etc/nginx/conf.d/*.conf; }' >> /etc/nginx/nginx.conf

EXPOSE 80

USER nextjs

CMD ["nginx", "-g", "daemon off;"]
